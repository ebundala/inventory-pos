
generator zod {
  provider = "prisma-zod-generator"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["filteredRelationCount","extendedWhereUnique","metrics","referentialIntegrity"]
  //"referentialIntegrity","interactiveTransactions"
  output   = "./generated/client"
}


datasource db {
  provider             = "postgresql"
  url                  = env("DATABASE_URL")
  relationMode  = "prisma"
}

model AdjustmentDetail {
  id               Int             @id @default(autoincrement())
  productId        Int
  adjustmentId     Int
  productVariantId Int?
  quantity         Float
  type             String          @db.VarChar(192)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  adjustment       Adjustment      @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tenant           Tenant          @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId         String

  @@index([tenantId])
  @@index([adjustmentId])
  @@index([productId])
  @@index([productVariantId])
}

model Adjustment {
  id                Int                @id @default(autoincrement())
  userId            String
  date              DateTime           @db.Date
  ref               String             @db.VarChar(192)
  warehouseId       Int
  items             Float?             @default(0)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  recordStatus      RecordStatus       @default(ACTIVE)
  user              User               @relation(fields: [userId], references: [id])
  warehouse         Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  adjustmentDetails AdjustmentDetail[]
  tenant            Tenant             @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId          String

  @@index([tenantId])
  @@index([userId])
  @@index([warehouseId])
}

model Attendance {
  id           Int          @id @default(autoincrement())
  userId       String
  companyId    Int
  employeeId   Int
  date         DateTime     @db.Date
  clockIn      String
  clockInIp    String       @db.VarChar(45)
  clockOut     String
  clockOutIp   String
  clockInOut   Boolean
  departEarly  String       @default("00:00")
  lateTime     String       @default("00:00")
  overtime     String       @default("00:00")
  totalWork    String       @default("00:00")
  totalRest    String       @default("00:00")
  status       String       @default("present")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  recordStatus RecordStatus @default(ACTIVE)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user         User         @relation(fields: [userId], references: [id], onUpdate: Restrict)
  tenant       Tenant       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId     String

  @@index([tenantId])
  @@index([companyId])
  @@index([employeeId])
  @@index([userId])
}

model Brand {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(192)
  description  String?      @db.VarChar(192)
  image        String?      @db.VarChar(192)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  recordStatus RecordStatus @default(ACTIVE)
  products     Product[]
  tenant       Tenant       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId     String

  @@index([tenantId])
}

model Category {
  id           Int          @id @default(autoincrement())
  code         String       @db.VarChar(192)
  name         String       @db.VarChar(192)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  recordStatus RecordStatus @default(ACTIVE)
  products     Product[]
  tenant       Tenant       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId     String

  @@index([tenantId])
}

model Customer {
  id           Int          @id @default(autoincrement())
  name         String
  code         Int
  email        String       @db.VarChar(192)
  country      String?
  city         String?
  phone        String?
  address      String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  recordStatus RecordStatus @default(ACTIVE)
  quotations   Quotation[]
  saleReturns  SaleReturn[]
  sales        Sale[]
  settings     Setting[]
  tenant       Tenant       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId     String

  @@index([tenantId])
}

model Company {
  id           Int           @id @default(autoincrement())
  name         String
  email        String?
  phone        String?
  country      String?
  city         String?
  address      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  recordStatus RecordStatus  @default(ACTIVE)
  attendances  Attendance[]
  departments  Department[]
  designations Designation[]
  employees    Employee[]
  holidays     Holiday[]
  leaves       Leave[]
  officeShifts OfficeShift[]
  tenant       Tenant        @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId     String

  @@index([tenantId])
}

model Currency {
  id           Int          @id @default(autoincrement())
  code         String       @db.VarChar(192)
  name         String       @db.VarChar(192)
  symbol       String       @db.VarChar(192)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  recordStatus RecordStatus @default(ACTIVE)
  settings     Setting[]
  tenant       Tenant       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId     String

  @@index([tenantId])
}

model Department {
  id               Int           @id @default(autoincrement())
  department       String
  companyId        Int
  departmentHeadId Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  recordStatus     RecordStatus  @default(ACTIVE)
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  departmentHead   Employee?     @relation("departments_department_headToemployees", fields: [departmentHeadId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  designations     Designation[]
  employees        Employee[]    @relation("departmentsToemployees_department_id")
  leaves           Leave[]
  tenant           Tenant        @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId         String

  @@index([tenantId])
  @@index([companyId])
  @@index([departmentHeadId])
}

model Designation {
  id           Int          @id @default(autoincrement())
  companyId    Int
  departmentId Int
  designation  String       @db.VarChar(192)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  recordStatus RecordStatus @default(ACTIVE)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  department   Department   @relation(fields: [departmentId], references: [id], onUpdate: Restrict)
  employees    Employee[]
  tenant       Tenant       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId     String

  @@index([tenantId])
  @@index([companyId])
  @@index([departmentId])
}

model EmployeeAccount {
  id           Int          @id @default(autoincrement())
  employeeId   Int
  bankName     String       @db.VarChar(192)
  bankBranch   String       @db.VarChar(192)
  accountNo    String       @db.VarChar(192)
  note         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  recordStatus RecordStatus @default(ACTIVE)
  employee     Employee     @relation(fields: [employeeId], references: [id], onUpdate: Restrict)
  tenant       Tenant       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId     String

  @@index([tenantId])
  @@index([employeeId])
}

model EmployeeExperience {
  id             Int          @id @default(autoincrement())
  employeeId     Int
  title          String       @db.VarChar(192)
  companyName    String       @db.VarChar(192)
  location       String?      @db.VarChar(192)
  employmentType String       @db.VarChar(192)
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  recordStatus   RecordStatus @default(ACTIVE)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  tenant         Tenant       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId       String

  @@index([tenantId])
  @@index([employeeId])
}

model Employee {
  id                  Int                  @id @default(autoincrement())
  firstname           String               @db.VarChar(192)
  lastname            String               @db.VarChar(192)
  username            String
  email               String?              @db.VarChar(192)
  phone               String?              @db.VarChar(192)
  country             String?              @db.VarChar(192)
  city                String?              @db.VarChar(192)
  province            String?              @db.VarChar(192)
  zipcode             String?              @db.VarChar(192)
  address             String?              @db.VarChar(192)
  gender              String               @db.VarChar(192)
  resume              String?              @db.VarChar(192)
  avatar              String?              @default("no_avatar.png") @db.VarChar(192)
  document            String?              @db.VarChar(192)
  birthDate           DateTime?            @db.Date
  joiningDate         DateTime?            @db.Date
  companyId           Int
  departmentId        Int
  designationId       Int
  officeShiftId       Int
  remainingLeave      Boolean?             @default(false)
  totalLeave          Boolean?             @default(false)
  hourlyRate          Decimal?             @default(0.00) @db.Decimal(10, 2)
  basicSalary         Decimal?             @default(0.00) @db.Decimal(10, 2)
  employmentType      String?              @default("full_time") @db.VarChar(192)
  leavingDate         DateTime?            @db.Date
  maritalStatus       String?              @default("single") @db.VarChar(192)
  facebook            String?              @db.VarChar(192)
  skype               String?              @db.VarChar(192)
  whatsapp            String?              @db.VarChar(192)
  twitter             String?              @db.VarChar(192)
  linkedin            String?              @db.VarChar(192)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  recordStatus        RecordStatus         @default(ACTIVE)
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  department          Department           @relation("departmentsToemployees_department_id", fields: [departmentId], references: [id], onUpdate: Restrict)
  designation         Designation          @relation(fields: [designationId], references: [id], onUpdate: Restrict)
  officeShift         OfficeShift          @relation(fields: [officeShiftId], references: [id], onUpdate: Restrict)
  attendances         Attendance[]
  headingDepartments  Department[]         @relation("departments_department_headToemployees")
  employeeAccounts    EmployeeAccount[]
  employeeExperiences EmployeeExperience[]
  leaves              Leave[]
  tenant              Tenant               @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId            String

  @@index([tenantId])
  @@index([companyId])
  @@index([departmentId])
  @@index([designationId])
  @@index([officeShiftId])
}

model ExpenseCategory {
  id           Int          @id @default(autoincrement())
  userId       String
  name         String       @db.VarChar(192)
  description  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  recordStatus RecordStatus @default(ACTIVE)
  user         User         @relation(fields: [userId], references: [id], onUpdate: Restrict)
  expenses     Expense[]
  tenant       Tenant       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId     String

  @@index([tenantId])
  @@index([userId])
}

model Expense {
  id                Int             @id @default(autoincrement())
  date              DateTime        @db.Date
  ref               String          @db.VarChar(192)
  userId            String
  expenseCategoryId Int
  warehouseId       Int
  details           String          @db.VarChar(192)
  amount            Float
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  recordStatus      RecordStatus    @default(ACTIVE)
  expenseCategory   ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onUpdate: Restrict)
  user              User            @relation(fields: [userId], references: [id], onUpdate: Restrict)
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id], onUpdate: Restrict)
  tenant            Tenant          @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId          String

  @@index([tenantId])
  @@index([expenseCategoryId])
  @@index([userId])
  @@index([warehouseId])
}

model Holiday {
  id           Int          @id @default(autoincrement())
  title        String       @db.VarChar(192)
  companyId    Int
  startDate    DateTime     @db.Date
  endDate      DateTime     @db.Date
  description  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  recordStatus RecordStatus @default(ACTIVE)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  tenant       Tenant       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId     String

  @@index([tenantId])
  @@index([companyId])
}

model leaveType {
  id           Int          @id @default(autoincrement())
  title        String       @db.VarChar(192)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  recordStatus RecordStatus @default(ACTIVE)
  leaves       Leave[]
  tenant       Tenant       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId     String

  @@index([tenantId])
}

model Leave {
  id           Int          @id @default(autoincrement())
  employeeId   Int
  companyId    Int
  departmentId Int
  leaveTypeId  Int
  startDate    DateTime     @db.Date
  endDate      DateTime     @db.Date
  days         String       @db.VarChar(192)
  reason       String?
  attachment   String?      @db.VarChar(192)
  halfDay      Boolean?
  status       String       @db.VarChar(192)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  recordStatus RecordStatus @default(ACTIVE)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  department   Department   @relation(fields: [departmentId], references: [id], onUpdate: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onUpdate: Restrict)
  leaveType    leaveType    @relation(fields: [leaveTypeId], references: [id], onUpdate: Restrict)
  tenant       Tenant       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId     String

  @@index([tenantId])
  @@index([companyId])
  @@index([departmentId])
  @@index([employeeId])
  @@index([leaveTypeId])
}

model OfficeShift {
  id           Int          @id @default(autoincrement())
  companyId    Int
  name         String
  mondayIn     String?
  mondayOut    String?
  tuesdayIn    String?
  tuesdayOut   String?
  wednesdayIn  String?
  wednesdayOut String?
  thursdayIn   String?
  thursdayOut  String?
  fridayIn     String?
  fridayOut    String?
  saturdayIn   String?
  saturdayOut  String?
  sundayIn     String?
  sundayOut    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  recordStatus RecordStatus @default(ACTIVE)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  employees    Employee[]
  tenant       Tenant       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId     String

  @@index([tenantId])
  @@index([companyId])
}

model PaymentPurchaseReturn {
  id               Int            @id @default(autoincrement())
  userId           String
  date             DateTime       @db.Date
  ref              String         @db.VarChar(192)
  purchaseReturnId Int
  amount           Float
  change           Float          @default(0)
  reglement        String
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  recordStatus     RecordStatus   @default(ACTIVE)
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onUpdate: Restrict)
  user             User           @relation(fields: [userId], references: [id], onUpdate: Restrict)
  tenant           Tenant         @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId         String

  @@index([tenantId])
  @@index([purchaseReturnId])
  @@index([userId])
}

model PaymentPurchase {
  id           Int          @id @default(autoincrement())
  userId       String
  date         DateTime     @db.Date
  ref          String       @db.VarChar(192)
  purchaseId   Int
  amount       Float
  change       Float        @default(0)
  reglement    String       @db.VarChar(192)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  recordStatus RecordStatus @default(ACTIVE)
  purchase     Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onUpdate: Restrict)
  tenant       Tenant       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId     String

  @@index([tenantId])
  @@index([purchaseId])
  @@index([userId])
}

model PaymentSaleReturn {
  id           Int          @id @default(autoincrement())
  userId       String
  date         DateTime     @db.Date
  ref          String       @db.VarChar(192)
  saleReturnId Int
  amount       Float
  change       Float        @default(0)
  reglement    String
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  recordStatus RecordStatus @default(ACTIVE)
  saleReturn   SaleReturn   @relation(fields: [saleReturnId], references: [id], onUpdate: Restrict)
  user         User         @relation(fields: [userId], references: [id], onUpdate: Restrict)
  tenant       Tenant       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId     String

  @@index([tenantId])
  @@index([saleReturnId])
  @@index([userId])
}

model PaymentSale {
  id           Int          @id @default(autoincrement())
  userId       String
  date         DateTime     @db.Date
  ref          String       @db.VarChar(192)
  saleId       Int
  amount       Float
  change       Float        @default(0)
  reglement    String       @db.VarChar(192)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  recordStatus RecordStatus @default(ACTIVE)
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onUpdate: Restrict)
  tenant       Tenant       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId     String

  @@index([tenantId])
  @@index([saleId])
  @@index([userId])
}

model PosSetting {
  id           Int          @id @default(autoincrement())
  noteCustomer String       @default("Thank You For Shopping With Us . Please Come Again") @db.VarChar(192)
  showNote     Boolean      @default(true)
  showBarcode  Boolean      @default(true)
  showDiscount Boolean      @default(true)
  showCustomer Boolean      @default(true)
  showEmail    Boolean      @default(true)
  showPhone    Boolean      @default(true)
  showAddress  Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  recordStatus RecordStatus @default(ACTIVE)
  tenant       Tenant       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId     String

  @@index([tenantId])
}

model ProductVariant {
  id                    Int                    @id @default(autoincrement())
  productId             Int
  name                  String?                @db.VarChar(192)
  qty                   Decimal?               @default(0.00) @db.Decimal(8, 2)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  recordStatus          RecordStatus           @default(ACTIVE)
  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  adjustmentDetails     AdjustmentDetail[]
  productWarehouse      ProductWarehouse[]
  purchaseDetails       PurchaseDetail[]
  purchaseReturnDetails PurchaseReturnDetail[]
  quotationDetails      QuotationDetail[]
  saleDetails           SaleDetail[]
  saleReturnDetails     SaleReturnDetail[]
  transferDetails       TransferDetail[]
  tenant                Tenant                 @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId              String

  @@index([tenantId])
  @@index([productId])
}

model ProductWarehouse {
  id               Int             @id @default(autoincrement())
  productId        Int
  warehouseId      Int
  productVariantId Int?
  qty              Float
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  recordStatus     RecordStatus    @default(ACTIVE)
  product          Product         @relation(fields: [productId], references: [id], onUpdate: Restrict)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  warehouse        Warehouse       @relation(fields: [warehouseId], references: [id], onUpdate: Restrict)
  tenant           Tenant          @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId         String

  @@index([tenantId])
  @@index([productVariantId])
  @@index([productId])
  @@index([warehouseId])
}

model Product {
  id                    Int                    @id @default(autoincrement())
  code                  String                 @db.VarChar(192)
  typeBarcode           String                 @db.VarChar(192)
  name                  String                 @db.VarChar(192)
  cost                  Float
  price                 Float
  categoryId            Int
  brandId               Int?
  unitId                Int?
  unitSaleId            Int?
  unitPurchaseId        Int?
  taxNet                Float?                 @default(0)
  taxMethod             String?                @default("1") @db.VarChar(192)
  image                 String?
  note                  String?
  stockAlert            Float?                 @default(0)
  isVariant             Boolean                @default(false)
  isImei                Boolean                @default(false)
  isActive              Boolean?               @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  recordStatus          RecordStatus           @default(ACTIVE)
  brand                 Brand?                 @relation(fields: [brandId], references: [id], onUpdate: Restrict)
  category              Category               @relation(fields: [categoryId], references: [id], onUpdate: Restrict)
  productUnit           Unit?                  @relation("products_unit_idTounits", fields: [unitId], references: [id], onUpdate: Restrict)
  productPurchaseUnit   Unit?                  @relation("products_unit_purchase_idTounits", fields: [unitPurchaseId], references: [id], onUpdate: Restrict)
  productsSaleUnit      Unit?                  @relation("products_unit_sale_idTounits", fields: [unitSaleId], references: [id], onUpdate: Restrict)
  adjustmentDetails     AdjustmentDetail[]
  productVariants       ProductVariant[]
  productWarehouse      ProductWarehouse[]
  purchaseDetails       PurchaseDetail[]
  purchaseReturnDetails PurchaseReturnDetail[]
  quotationDetails      QuotationDetail[]
  saleDetails           SaleDetail[]
  saleReturnDetails     SaleReturnDetail[]
  transferDetails       TransferDetail[]
  tenant                Tenant                 @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId              String

  @@index([tenantId])
  @@index([brandId])
  @@index([categoryId])
  @@index([unitId])
  @@index([unitSaleId])
  @@index([unitPurchaseId])
}

model Supplier {
  id              Int              @id @default(autoincrement())
  name            String
  code            Int
  email           String           @unique @db.VarChar(192)
  phone           String?
  country         String?
  city            String?
  address         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  recordStatus    RecordStatus     @default(ACTIVE)
  purchaseReturns PurchaseReturn[]
  purchases       Purchase[]
  tenant          Tenant           @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tenantId        String


  @@index([tenantId])
}

model PurchaseDetail {
  id               Int             @id @default(autoincrement())
  cost             Float
  purchaseUnitId   Int?
  taxNet           Float?          @default(0)
  taxMethod        String?         @default("1") @db.VarChar(192)
  discount         Float?          @default(0)
  discountMethod   String?         @default("1") @db.VarChar(192)
  purchaseId       Int
  productId        Int
  productVariantId Int?
  imeiNumber       String?
  total            Float
  quantity         Float
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
